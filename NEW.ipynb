def forremovebutton():
    global removelabel

    # Clear all buttons from frame
    for widget in frame.winfo_children(): #Use this whenever you want to do somethign with all the buttons in one frame (frame ex: button_frame, frame, root, or frame2 are some I used rn)
        widget.grid_remove()

    removelabel = tk.Label(root, text="Select the item you don't want anymore", font=("Times New Roman", 12)) 
    removelabel.pack(padx=10)

    frame.pack(padx=10, pady=10)

    row = 0
    col = 0
    def place(button):
        nonlocal row, col
        button.grid(row=row, column=col, padx=10, pady=10)
        col += 1
        if col > 2: 
            col = 0
            row += 1

    if "Appetizer: Apple sauce" in userchoice:  
        place(removeapplesauce)
    if "Appetizer: Burger" in userchoice:
        place(removeburger)
    if "Appetizer: Pizza" in userchoice:
        place(removepizza)
    if "Drink: Dr Pepper" in userchoice:
        place(removedrpepper)
    if "Drink: Lemonade" in userchoice:
        place(removelemonade)
    if "Drink: Pepsi" in userchoice:
        place(removepepsi)
    if "Sauce: Honey BBQ" in userchoice:
        place(removebbq)
    if "Sauce: Mustard" in userchoice:
        place(removemustard)
    if "Sauce: Ketchup" in userchoice:
        place(removeketchup)
    if "Dessert: Molten Lava Cake" in userchoice:
        place(removemoltencake)
    if "Dessert: Frosted Caramalized Apples" in userchoice:
        place(removefrostedcaramelapples)
    if "Dessert: Butterscotch Pie" in userchoice:
        place(removebutterscotchpie)
    if "Soup: Tomato Soup" in userchoice:
        place(removetomatosoup)
    if "Soup: Lento Soup" in userchoice:
        place(removelentosoup)
    if "Soup: Miso Soup" in userchoice:
        place(removemisosoup)
    if "Entree: Steak" in userchoice:
        place(removesteak)
    if "Entree: Tacos" in userchoice:
        place(removetacos)
    if "Entree: Pasta" in userchoice:
        place(removepasta)
