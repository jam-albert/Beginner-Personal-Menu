def submit():
    global tip
    try:
        tip = float(payout.get())
    except ValueError:
        tip = 0.0
    global foodlabel, drinklabel, saucelabel, dessertlabel, removelabel, souplabel, entreelabel, payoutquestion

    # Destroy any labels so they don’t stack
    for label in [foodlabel, drinklabel, saucelabel, dessertlabel, removelabel, souplabel, entreelabel, payoutquestion]:
        if label:
            label.destroy()

    foodlabel = drinklabel = saucelabel = dessertlabel = removelabel = souplabel = entreelabel = None

    # Clear comments
    for label in [choicelabel, commentlabel, saucecomment, dessertcomment, soupcomment, entreecomment, payout]:
        label.config(text="")
        label.pack_forget()

    second_label.config(text="")

    # Remove all buttons from frame
    for widget in frame.winfo_children():
        widget.grid_remove()

    # Hide frame
    frame.pack_forget()

    # Re-enable main buttons
    for btn in [right_button, wrongbutton, button3, button4, button5, button6, button7, removebutton]:
        btn.config(state="normal")

    

