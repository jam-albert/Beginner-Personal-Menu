def show_choice():
    global totalprice
    global tax
    global price 
    global tip
    tax = price * .0825
    totalprice = tax + price
    
    if not userchoice:
        messagebox.showinfo("Your Choices", f"Nothing was added.\nTotal Cost: {price}")
    else:
        choices = "\n".join(userchoice)
        messagebox.showinfo("Your Choices", f"\n{choices}\n\nItem cost: {price:.2f}\nTax: {tax:.2f}\nTotal Cost: {totalprice:.2f}\nTip: {tip:.2f}") 
    
       
